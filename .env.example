# JA4LookR Configuration
# Copy this file to .env and fill in your values

# Flask secret key (REQUIRED for production - generate a random string)
# Example: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-key-change-this-in-production

# VirusTotal API Key (OPTIONAL - enables VirusTotal integration)
# Get your free API key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Cache settings (OPTIONAL)
# CACHE_DIR=.ja4_cache
# CACHE_DAYS=7
